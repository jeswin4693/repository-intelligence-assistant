{
  "name": "repository-intelligence-assistant",
  "version": "0.1.0",
  "description": "Repo navigation and change-impact tools for AI chats, served over MCP",
  "main": "dist/index.js",
  "bin": {
    "ria": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "keywords": [
